# ── Supabase (Auth + Postgres) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Set true only after enabling/configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ── Claude API (deep report generation) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for the deep report. Options:
#   claude-sonnet-5    (recommended balance)
#   claude-opus-4-8    (deepest, higher cost)
#   claude-haiku-4-5   (fastest, cheapest)
REPORT_MODEL=claude-sonnet-5
# Per authenticated user, counted from 00:00 UTC.
REPORT_DAILY_LIMIT=5

# Optional paywall. Keep false until profiles migration is applied and checkout is wired.
NEXT_PUBLIC_REQUIRE_PLAN=false

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://awareness.aiedu.academy
