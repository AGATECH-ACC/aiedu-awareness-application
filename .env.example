# ── Supabase (Auth + Postgres) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Legacy fallback used by existing Vercel projects. The app accepts either key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY
# Resend is configured as custom SMTP inside Supabase Auth. Never expose its
# API key with a NEXT_PUBLIC_ variable or commit it to this file.
# Report delivery uses the same Resend account through its server API. Add the
# existing API key separately; Supabase does not reveal its stored SMTP secret.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Awareness by AiEdu <reports@app.aiedu.academy>
# Required by trusted recipient-OTP/report routes. Prefer a modern sb_secret_ key;
# a legacy service-role key is accepted through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional domain-separated OTP secret. If omitted, the Supabase secret key is
# safely derived for ten-minute OTP signing. Use 32+ random characters if set.
RECIPIENT_OTP_SECRET=
# ── Deep reports ─────────────────────────────────────────────
# Version 1 builds reports from the reviewed bilingual card dataset and does
# not call an AI model. AI-enhanced reports are reserved for a later version.
# Per authenticated user, counted from 00:00 UTC.
REPORT_DAILY_LIMIT=5

# Optional paywall. Keep false until profiles migration is applied and checkout is wired.
NEXT_PUBLIC_REQUIRE_PLAN=false

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://app.aiedu.academy
